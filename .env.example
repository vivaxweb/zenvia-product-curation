# ==========================================
# Zenvia AI Environment Configuration
# Copy this file to .env and fill in your keys
# ==========================================

# OpenRouter API Key (Free tier supported: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Meta Model API / Groq / HuggingFace tokens
MODEL_API_KEY=your_meta_model_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# Model Selection (defaults to free multimodal vision endpoint)
AI_MODEL=dots-studio/dots-3-note-preview:free

# Runtime Settings
REQUEST_TIMEOUT=45
MAX_TOKENS=2048
TEMPERATURE=0.15
MAX_RETRIES=3
